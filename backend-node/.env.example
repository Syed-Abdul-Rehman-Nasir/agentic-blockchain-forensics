# ─────────────────────────────────────────────
# Agentic Blockchain Forensics — Environment Configuration
# Copy this file to .env and edit the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Blockchain backend ─────────────────────────────────────────────────────
# Set to false to use the built-in SQLite mock chain (recommended for setup).
# Set to true only when Hyperledger Fabric test-network is running AND
# peer0.org1 is listening on :7051 (not just CCAAS containers).
# Always start Fabric with: bash scripts/start-fabric.sh
# Always stop Fabric with:  bash scripts/stop-fabric.sh
# Note: start-fabric uses cryptogen + localhost:17051 port-fix when Docker
# Desktop leaves stale :7051 proxies (common on WSL2).
USE_REAL_FABRIC=false

# ── Fabric connection (only relevant when USE_REAL_FABRIC=true) ────────────
CHANNEL_NAME=forensicchannel
CHAINCODE_NAME=forensiccc
MSP_ID=Org1MSP
# Prefer localhost:17051 after scripts/start-fabric.sh (bypasses stale Docker :7051).
# start-fabric also writes .fabric-endpoints.env — loaded automatically by server.js.
PEER_ENDPOINT=localhost:17051
PEER_HOST_ALIAS=peer0.org1.example.com
# Path to Fabric crypto material (fabric-samples test-network default):
# CRYPTO_PATH=/home/<your-username>/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com

# ── Python AI service ──────────────────────────────────────────────────────
# URL the Node backend uses to reach the Python AI service.
AI_SERVICE_URL=http://127.0.0.1:8000

# ── Ollama (LLM) ───────────────────────────────────────────────────────────
# If Ollama runs on Windows and this project runs in WSL2, set the
# Windows host IP (run `cat /etc/resolv.conf | grep nameserver` in WSL2).
# If Ollama runs natively in Linux, use http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── Node backend port ──────────────────────────────────────────────────────
PORT=3000
